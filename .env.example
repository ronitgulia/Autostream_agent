# Copy this file to .env and fill in your credentials
# cp .env.example .env

# ── Choose your LLM provider & model ──────────────────────────────────────────
LLM_PROVIDER=anthropic    # Options: anthropic | openai | google | groq
# Optional model override (defaults: claude-3-5-haiku-latest, gpt-4o-mini, gemini-2.0-flash, llama-3.3-70b-versatile)
# LLM_MODEL=claude-3-5-haiku-latest

# ── API Keys (only the one matching LLM_PROVIDER is required) ─────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_API_KEY=your_google_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── LangSmith Observability (optional but highly recommended) ─────────────────
# Sign up free at https://smith.langchain.com — get your API key from Settings.
# Once set, every run is traced: graph execution, tool calls, token latency.
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=autostream-agent

# ── WhatsApp Cloud API Webhook (optional for server.py) ───────────────────────
WHATSAPP_TOKEN=your_meta_system_user_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=autostream_webhook_verify_token_here
WHATSAPP_APP_SECRET=your_meta_app_secret_for_hmac_here

# ── Distributed State & Cache (optional for server.py) ────────────────────────
# If unset, server.py uses in-memory LRU session cache.
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=86400
